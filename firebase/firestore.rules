rules_version = '2';

// Divvup — Security Rules (SPEC §4.2). Padrão: negar tudo.
// Leitura de dados da casa só para membros ativos; escrita direta só em campos não sensíveis.
// Pontos, atribuição, papéis e vínculo com casa são gravados apenas pelo backend (conta de
// serviço, que ignora estas regras). Cada coleção liberada entra aqui com teste no Emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Perfil: cada um lê só o próprio. Criação e campos sensíveis (pontos, casa, sequência)
    // são do backend (`criarPerfil` e operações da casa).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
