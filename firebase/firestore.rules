rules_version = '2';

// Divvup — Security Rules (SPEC §4.2). Padrão: negar tudo.
// Leitura de dados da casa só para membros ativos; escrita direta só em campos não sensíveis.
// Pontos, atribuição, papéis e vínculo com casa são gravados apenas pelo backend (conta de
// serviço, que ignora estas regras). Cada coleção liberada entra aqui com teste no Emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Perfil: cada um lê só o próprio. Criação e campos sensíveis (pontos, casa, sequência)
    // são do backend (`criarPerfil` e operações da casa).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // B1/E3 (R-32): o dono muda só nome de exibição (1–24) e avatar da galeria.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarId'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.matches('avataaars:divvup-(0[1-9]|1[0-9]|2[0-4])');
    }
  }
}
