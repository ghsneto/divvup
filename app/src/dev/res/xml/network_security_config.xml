<?xml version="1.0" encoding="utf-8"?>
<!--
    Só no flavor dev: o Firebase Emulator e o Worker local falam HTTP sem TLS, num IP que muda
    (10.0.2.2 no emulador Android, o IP do computador num aparelho físico). O flavor prod não tem
    este arquivo e só fala HTTPS.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
