{
  "name": "divvup-backend",
  "private": true,
  "type": "module",
  "description": "Backend do Divvup em Cloudflare Workers (ADR 0001). Operações protegidas e tarefas agendadas.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:emulador": "firebase emulators:exec --config ../firebase/firebase.json --project demo-divvup --only auth,firestore \"vitest run\""
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
